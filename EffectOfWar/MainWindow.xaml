<Window x:Name="window" x:Class="EffectOfWar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EffectOfWar"
        mc:Ignorable="d"
        Title="Effect of War" Height="450" Width="800" ResizeMode="CanMinimize" WindowState="Maximized">
    <Grid>
        <Grid x:Name="Menu" Grid.ColumnSpan="2">
            <TextBox x:Name="BasicStatShower" HorizontalAlignment="Left" Margin="592,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            
        </Grid>
        <Grid x:Name="Battleground" Grid.ColumnSpan="2">
            <TextBox x:Name="Console"/>

        </Grid>
    </Grid>
</Window>
