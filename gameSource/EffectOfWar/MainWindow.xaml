<Window x:Class="EffectOfWar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EffectOfWar"
        mc:Ignorable="d"
        Title="Effect of War" Height="450" Width="800" ResizeMode="CanMinimize" WindowState="Maximized">
    <Grid>
        <Grid x:Name="Menu"
      MinWidth="1000">

            <!-- ===== GRID STRUKTÚRA ===== -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- címkék -->
                <RowDefinition Height="*"/>
                <!-- listák -->
                <RowDefinition Height="Auto"/>
                <!-- label 1 -->
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <!-- label 2 + radio -->
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== -->
            <!-- CÍMKÉK -->
            <!-- ===================== -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Warriors" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Rangers" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Supports" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Bosses" HorizontalAlignment="Center"/>

            <!-- ===================== -->
            <!-- LISTÁK -->
            <!-- ===================== -->

            <!-- WARRIORS -->
            <ListBox x:Name="WarriorsList" Grid.Row="1" Grid.Column="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="DarkOrange">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Height" Value="120"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">

                            <!-- NÉV -->
                            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                            <!-- KÉP -->
                            <Image Source="{Binding ImagePath}"
                   Width="100"
                   Height="100"
                   Stretch="UniformToFill"/>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- RANGERS -->
            <ListBox x:Name="RangersList" Grid.Row="1" Grid.Column="1"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="DarkRed">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Height" Value="120"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">

                            <!-- NÉV -->
                            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                            <!-- KÉP -->
                            <Image Source="{Binding ImagePath}"
                   Width="100"
                   Height="100"
                   Stretch="UniformToFill"/>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- SUPPORTS -->
            <ListBox x:Name="SupportsList" Grid.Row="1" Grid.Column="2"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Green">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Height" Value="120"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">

                            <!-- NÉV -->
                            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                            <!-- KÉP -->
                            <Image Source="{Binding ImagePath}"
                   Width="100"
                   Height="100"
                   Stretch="UniformToFill"/>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- BOSSES -->
            <ListBox x:Name="BossesList" Grid.Row="1" Grid.Column="3"
 ScrollViewer.VerticalScrollBarVisibility="Auto"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Purple">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Height" Value="120"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">

                            <!-- NÉV -->
                            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                            <!-- KÉP -->
                            <Image Source="{Binding ImagePath}"
                   Width="100"
                   Height="100"
                   Stretch="UniformToFill"/>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===================== -->
            <!-- STAT BOX -->
            <!-- ===================== -->
            <TextBox x:Name="BasicStatShower" Grid.Row="1"
             Grid.Column="4"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Background="Gray"/>
            
            <Label Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="5"
           Content="Csapat 1: "
           HorizontalContentAlignment="Center"/>

            <Label Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Content="Csapat 2: "
            HorizontalContentAlignment="Center"/>

            <!-- RADIO BUTTONS -->
            <UniformGrid Columns="3" Grid.Row="4" Grid.ColumnSpan="5">
                <RadioButton Content="1 csapat választ" HorizontalAlignment="Center"/>
                <RadioButton Content="2 csapat választ" HorizontalAlignment="Center"/>
                <RadioButton Content="Csak megtekintés" HorizontalAlignment="Center"/>
            </UniformGrid>

        </Grid>

        <Grid x:Name="Battleground" Grid.ColumnSpan="2" Visibility="Collapsed">
            <TextBox x:Name="ConsoleD"/>

        </Grid>

    </Grid>
</Window>
