<Window x:Class="EffectOfWar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EffectOfWar"
        mc:Ignorable="d"
        Title="Effect of War" ResizeMode="CanMinimize" WindowState="Maximized"
        WindowStyle="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border 
                Background="#222"
                VerticalAlignment="Stretch" Grid.Row="0">

            <DockPanel>

                <TextBlock Text="Effect of War"
                           Foreground="White"
                           Margin="10,0"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    
                    <Button Content="Console"
                            Width="50"
                            Click="ConsoleVis"/>

                    <Button Content="INFOS"
                        Width="50"
                        Click="ShowDatas"/>

                    <Button Content="_"
                            Width="35"
                            Click="Minimize_Click"/>

                    <Button Content="X"
                            Width="35"
                            Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="Menu" Grid.Row="1">

            <!-- ===== GRID STRUKTÚRA ===== -->
            <Grid.RowDefinitions>
                <!-- listák -->
                <RowDefinition Height="Auto"/>
                <!-- alsó rész -->
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== -->
            <!-- STAT BOX -->
            <!-- ===================== -->
            <TextBox x:Name="BasicStatShower" Grid.Row="0"
             Grid.Column="4"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Background="Gray" Padding="2,2,15,2"/>

            <Label Grid.Row="1"
           Grid.Column="0"
           Grid.ColumnSpan="5"
           Content="Csapat 1: "
           HorizontalContentAlignment="Center"
                   x:Name="firstShower"/>

            <Label Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Content="Csapat 2: "
            HorizontalContentAlignment="Center"
                   x:Name="secondShower"/>

            <!-- RADIO BUTTONS -->
            <UniformGrid Columns="3" Grid.Row="3" Grid.ColumnSpan="5">
                <RadioButton x:Name="firstTeam" Content="1 csapat választ" HorizontalAlignment="Center"/>
                <RadioButton x:Name="secondTeam" Content="2 csapat választ" HorizontalAlignment="Center"/>
                <RadioButton x:Name="noTeam" Content="Csak megtekintés" HorizontalAlignment="Center" IsChecked="True"/>
            </UniformGrid>
            <Button x:Name="GamemodeB" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="4" Click="ChangeGamemode"/>
            <Button Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="5" Click="StartGame" Content="Start Game"/>
        </Grid>

        <Grid x:Name="Battleground" Visibility="Collapsed" Grid.Row="1">
            <Grid.ColumnDefinitions> <!--9 oszlop 2 nyíl, 2 talent, 2 skill, 2 kép és középső rész-->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.75*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ConsoleD" Visibility="Collapsed" Panel.ZIndex="4" Grid.Row="0" Grid.Column="0" Grid.RowSpan="8" Grid.ColumnSpan="9" IsReadOnly="True"/>
            <Grid x:Name="team1UI" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <!--1 kép, 1 nyíl, 1 képesség, 1 talent-->
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Row="0" IsReadOnly="True" x:Name="SelectedSkills" TextWrapping="Wrap"/>
                <Button Grid.Row="1" Content="Select" x:Name="SkillUseFuncB"/>
                <Button Grid.Row="2" Content="Fire" x:Name="FireB"/>
                <TextBox Grid.Row="3" IsReadOnly="True" x:Name="CharacterDataInWar" TextWrapping="Wrap"/>
            </Grid>

            <Grid x:Name="team2UI" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <!--1 talent, 1 képesség, 1 nyíl, 1 kép-->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>

        <Grid x:Name="InfosG" Visibility="Collapsed" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            
        </Grid>
    </Grid>
</Window>